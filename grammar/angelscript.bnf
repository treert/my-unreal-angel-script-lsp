# ============================================================================
# Unreal Angelscript (.as) — Extended BNF Grammar Specification
# ============================================================================
#
# This file is the **formal grammar reference** for the Unreal Angelscript
# language (Hazelight's UE plugin dialect of AngelScript).
#
# IMPLEMENTATION: ./grammar.js (Tree-sitter) implements this document.
# Intentional deviations (node-name merges, `(void)` parameter lists,
# template declaration heads `struct TMap<K,V>`, optional trailing ';',
# unsupported [dead] productions, ...) are listed in ./README.md.
# Change this file first, then grammar.js.
#
# Sources analyzed (do not trust vanilla angelcode docs — the UE fork diverges):
#
#   [ENGINE]  d:/WorkGit/UnrealEngine/Engine/Plugins/Angelscript/ThirdParty/
#             source/as_parser.cpp     — authoritative recursive-descent
#             parser, inline "BNF:" comments (SCRIPT ::= is the start rule)
#             source/as_tokendef.h     — actual token/keyword table
#             source/as_tokenizer.cpp  — lexer (numbers, strings, heredoc)
#   [PPROC]   .../AngelscriptCode/Private/Preprocessor/AngelscriptPreprocessor.cpp
#             — rewrites UE extensions (UCLASS/UFUNCTION macros, delegate/
#             event, f""/n"" literals, `asset ... of`, ...) into core AS
#             before [ENGINE] parses
#   [LSP]     language-server/pegjs/angelscript.pegjs — tolerant LSP grammar
#             (multi-entry, incomplete productions; superset of [ENGINE])
#
# CRITICAL: there are TWO grammar layers:
#
#   Layer A (SOURCE) — what the user writes in .as files.  This is what a
#     Tree-sitter parser must accept.  Includes UCLASS()/UFUNCTION()/...,
#     delegate/event decls, f""/n"" literals, `asset X of Y`.
#   Layer B (CORE)  — what asCParser::ParseScript accepts.  [PPROC] rewrites
#     Layer-A-only constructs into Layer B + generated code.  Layer B itself
#     is vanilla-AS-minus-a-lot (see Part 4 divergence table).
#
# This BNF targets Layer A and marks each production with its layer:
#   [core]    accepted directly by asCParser
#   [pproc]   consumed/rewritten by AngelscriptPreprocessor, never seen by
#             asCParser
#   [lsp]     LSP-only tolerance production (error recovery / mid-edit);
#             NOT part of the language — included for error-recovery design
#
# Notation (ISO 14977 EBNF with light extensions, same as lua.bnf):
#
#   { A }        zero or more repetitions of A
#   [ A ]        optional A
#   A | B        alternative
#   'x'          terminal string / keyword
#   ( A )        grouping
#   (* ... *)    inline comment
#   #            line comment (this file only)
#   /re/         lexical regex (terminal)
#   [dead]       production exists in code but unreachable in the UE fork
#
# ============================================================================


# ############################################################################
#  Part 1 — Lexical Rules (Terminals)
# ############################################################################

# ----------------------------------------------------------------------------
# 1.1  Identifiers
# ----------------------------------------------------------------------------

IDENTIFIER       ::= /[A-Za-z_][A-Za-z0-9_]*/   (* excluding reserved keywords *)

# ----------------------------------------------------------------------------
# 1.2  Keywords (reserved) — as_tokendef.h tokenWords[] (UE fork)
# ----------------------------------------------------------------------------
# NOTE vs vanilla AngelScript: 'interface', 'funcdef', 'typedef', 'is',
# 'not', 'and', 'or', 'xor', '@' (handle), 'null' are COMMENTED OUT in the UE
# fork — they are NOT keywords and NOT part of the language.
# Added by UE fork: 'Cast', 'access', 'local', 'fallthrough', 'nullptr',
# 'float32', 'float64', 'unresolved_object'. 'int32'/'uint32' alias
# 'int'/'uint' at tokenizer level.

KEYWORD          ::= 'if' | 'else' | 'for' | 'while' | 'do' | 'switch'
                   | 'case' | 'default' | 'break' | 'continue' | 'return'
                   | 'fallthrough'
                   | 'bool' | 'int' | 'int8' | 'int16' | 'int64'
                   | 'uint' | 'uint8' | 'uint16' | 'uint64'
                   | 'float' | 'float32' | 'float64' | 'double' | 'void'
                   | 'true' | 'false' | 'nullptr'
                   | 'const' | 'private' | 'protected' | 'namespace'
                   | 'class' | 'struct' | 'enum' | 'mixin' | 'local'
                   | 'access' | 'auto' | 'Cast' | 'in' | 'out' | 'inout'
                   | 'import'
                   | 'unresolved_object'   (* engine-internal marker type *)

# "Contextual" keywords — ordinary identifiers with meaning only in specific
# positions (as_tokendef.h bottom list).  They stay valid IDENTIFIERs
# everywhere else:
#   this  super  from  final  override  property  deprecated  no_discard
#   allow_discard  defaults  get  set  readonly  editdefaults  inherited
#   mixin  function  delegate  event  asset  of  UCLASS  UFUNCTION
#   UPROPERTY  USTRUCT  UENUM  UMETA  repeat  repeat_same
#   __generated  no_discard  unsafe_during_construction  accept_temporary_this
#   external_implicit_this  if_handle_then_const  handle_only
#   __auto_constref_type  __any_implicit_integer

# ----------------------------------------------------------------------------
# 1.3  Primitive type names  [core]  (BNF: PRIMTYPE)
# ----------------------------------------------------------------------------

PRIMTYPE         ::= 'void' | 'bool'
                   | 'int8' | 'int16' | 'int' | 'int64'
                   | 'uint8' | 'uint16' | 'uint' | 'uint64'
                   | 'float32' | 'float64'
                   | 'float'      (* alias: float64 (ep.floatIsFloat64) *)
                   | 'double'     (* alias: float64, deprecated *)

# ----------------------------------------------------------------------------
# 1.4  Numerals  (as_tokenizer.cpp)
# ----------------------------------------------------------------------------

NUMBER           ::= IntegerLiteral | FloatLiteral | BitsLiteral

IntegerLiteral   ::= /[0-9]+/                      (* int64/uint by magnitude *)

FloatLiteral     ::= /[0-9]+\.[0-9]*([eE][+-]?[0-9]+)?[fF]?/   (* f => float32 *)
                   | /[0-9]+[eE][+-]?[0-9]+[fF]?/
                   | /\.[0-9]+([eE][+-]?[0-9]+)?[fF]?/
(* No suffix  -> float64 (double) is the default float type in UE fork.
   'f' suffix -> float32. *)

BitsLiteral      ::= /0[xX][0-9a-fA-F]+/           (* hexadecimal *)
                   | /0[bB][01]+/                  (* binary *)
                   | /0[oO][0-7]+/                 (* octal *)
                   | /0[dD][0-9]+/                 (* explicit decimal *)

# ----------------------------------------------------------------------------
# 1.5  String literals  (as_tokenizer + [PPROC])
# ----------------------------------------------------------------------------

StringLiteral    ::= OrdinaryString | HeredocString
OrdinaryString    ::= '"' { string_char | escape_sequence } '"'
string_char       ::= <any char except '"', '\\', CR, LF>
escape_sequence   ::= '\\' (
                        'a' 'b' 'f' 'n' 'r' 't' 'v' '0' '\\' '"' "'"
                      | /[0-7]{1,3}/               (* octal *)
                      | /[xX][0-9a-fA-F]+/         (* hex  *)
                      )

HeredocString     ::= '"""' { <any char except '\\', '"""'> } '"""'
(* multi-line, NO escape processing (as_tokenizer ttHeredocStringConstant) *)

# FName literal  [pproc]  —  n"..."  rewritten to __STATIC_NAME(idx)
NameLiteral       ::= 'n' '"' { string_char | escape_sequence } '"'

# Format string  [pproc]  —  f"..."  rewritten to a Format(...) call;
# '{' '}' delimit interpolated expressions; '{{' '}}' are literal braces
FormatString      ::= 'f' '"' { string_char | escape_sequence
                              | '{' <balanced expr text> '}' } '"'

# ----------------------------------------------------------------------------
# 1.6  Comments
# ----------------------------------------------------------------------------

comment           ::= line_comment | block_comment
line_comment      ::= '//' <any chars except newline> EOL
block_comment     ::= '/*' <any text, not nesting> '*/'
doc_comment       ::= block_comment | line_comment
(* No dedicated doc syntax: [LSP] attaches any contiguous comment run
   immediately preceding a declaration as its documentation. *)

# ----------------------------------------------------------------------------
# 1.7  Preprocessor directives  [pproc]
# ----------------------------------------------------------------------------
# A line whose first non-whitespace char is '#'.  Conditional chunks are
# resolved by AngelscriptPreprocessor (flags: EDITOR, COOK_COMMANDLET, EDITORONLY_DATA,
# RELEASE, TEST, WITH_SERVER_CODE, project settings).  For Tree-sitter these
# should be preserved as opaque `preproc_line` tokens for region-aware
# highlighting, NOT evaluated.

preproc_directive ::= '#' <rest of line>
(* observed forms: #if FLAG / #else / #endif / #include "..." *)

# ----------------------------------------------------------------------------
# 1.8  Operators & punctuation  (as_tokendef.h, UE fork)
# ----------------------------------------------------------------------------

(* Arithmetic *)       '+'  '-'  '*'  '/'  '%'  '**'
(* Compound assign *)  '+=' '-=' '*=' '/=' '%=' '**='
(* Bitwise *)           '|'  '^'  '&'  '~'  '<<'  '>>'  '>>>'
(* Bit-assign *)       '|=' '^=' '&=' '<<=' '>>=' '>>>='
(* Compare *)           '==' '!=' '<'  '<=' '>'  '>='
(* Logic *)             '&&' '||'        (* '&&&'/'||' — 'and/or/xor' REMOVED *)
(* Unary *)             '!'  '++' '--'
(* Assign *)            '='
(* Ternary *)           '?'  ':'
(* Member / scope *)    '.'  '::'
(* Delimiters *)        ';'  ','  '(' ')'  '[' ']'  '{'  '}'
(* NOTE: '@' handle operator is REMOVED in the UE fork. *)


# ############################################################################
#  Part 2 — Source-level Syntax (Layer A)
# ############################################################################

# ----------------------------------------------------------------------------
# 2.1  Script  [core]  (BNF:0 SCRIPT, asCParser::ParseScript)
# ----------------------------------------------------------------------------
# As accepted after [PPROC] rewriting.  Layer-A-only members are marked.

SCRIPT            ::= { top_declaration | ';' }

top_declaration   ::= namespace_decl                      (* 2.2 *)
                    | class_decl                          (* 2.3 *)
                    | struct_decl                         (* 2.3 *)
                    | enum_decl                           (* 2.4 *)
                    | delegate_decl                       (* 2.5  [pproc] *)
                    | event_decl                          (* 2.5  [pproc] *)
                    | mixin_function                      (* 2.6 *)
                    | local_function                      (* 2.6 *)
                    | global_function                     (* 2.7 *)
                    | global_var                          (* 2.7 *)
                    | asset_decl                          (* 2.8  [pproc] *)
                    | import_decl                         (* 2.9  [dead] *)
                    | typedef_decl                        (* 2.9  [dead] *)
                    | interface_decl                      (* 2.9  [dead] *)
                    | funcdef_decl                        (* 2.9  [dead] *)

# ----------------------------------------------------------------------------
# 2.2  Namespace  [core]  (BNF:1 NAMESPACE — nested names supported)
# ----------------------------------------------------------------------------

namespace_decl    ::= 'namespace' IDENTIFIER { '::' IDENTIFIER } '{' SCRIPT '}'

# ----------------------------------------------------------------------------
# 2.3  Class / Struct  [core+pproc]
# ----------------------------------------------------------------------------
# UCLASS/USTRUCT macro is Layer A only; [PPROC] strips it and [ENGINE]
# sees plain 'class Name : Base { ... }'.  Superclass list uses scope-qualified
# names (ParseOptionalScope), unlike vanilla's bare IDENTIFIER list.

class_decl        ::= [ UCLASS '(' macro_list ')' ]        (* [pproc] *)
                      'class' IDENTIFIER
                      [ ':' scoped_name { ',' scoped_name } ]
                      '{' { class_member } '}'

struct_decl       ::= [ USTRUCT '(' macro_list ')' ]       (* [pproc] *)
                      'struct' IDENTIFIER
                      [ ':' scoped_name { ',' scoped_name } ]
                      '{' { class_member } '}'

class_member      ::= ';'                                   #(* empty *)
                    | access_specifier                      (* 2.3.1 *)
                    | access_decl                           (* 2.3.2 *)
                    | class_default_statement               (* 2.3.3 *)
                    | constructor_decl                      (* 2.3.4 *)
                    | destructor_decl                       (* 2.3.4 *)
                    | class_property                        (* 2.3.5 *)
                    | class_method                          (* 2.3.6 *)
                    | virtual_property                      (* 2.3.7 *)
                    | funcdef_decl                          (* [dead] *)

# 2.3.1 — Visibility specifier preceding members.  The 'private:' colon form
# is NOT part of this language; use bare 'private'/'protected' lines, or
# 'access : Name' to switch default level.

access_specifier  ::= 'private' | 'protected'
                    | 'access' [ ':' IDENTIFIER ]           (* set level *)
# ('public' is accepted by [LSP] but not meaningful — everything is public
#  unless marked; engine tokens only define private/protected.)

# 2.3.2 — Friend/granular access declaration  (ParseAccessDecl)
#   e.g.  access MyHelper = private(readonly), System::Util, *;

access_decl       ::= 'access' IDENTIFIER '=' access_level
                      { ',' ( IDENTIFIER | '*' ) [ '(' access_mod_list ')' ] }
                      ';'
access_level      ::= 'private' | 'protected'
access_mod_list   ::= ( 'readonly' | 'editdefaults' | 'inherited' )
                      { ',' ( 'readonly' | 'editdefaults' | 'inherited' ) }

# 2.3.3 — Class default-value statement  (ParseClassDefaultStatement)
#   e.g.  default RootComponent = CreateDefaultSubobject(...);
#   or inside a  default { ... }  block  [LSP treats both as statements]

class_default_statement ::= 'default' ( assignment | '{' { assignment ';' } '}' )

# 2.3.4 — Constructor / Destructor  (ParseFunction isMethod path)

constructor_decl  ::= IDENTIFIER '(' parameter_list ')' [method_attributes]
                      ( ';' | statement_block )
destructor_decl   ::= '~' IDENTIFIER '(' ')' [method_attributes]
                      ( ';' | statement_block )
(* constructor name must equal the class name; no return type *)

# 2.3.5 — Class property  [core VAR + UPROPERTY macro]

class_property    ::= [ access_specifier ]
                      [ UPROPERTY '(' macro_list ')' ]      (* [pproc] *)
                      [ access_specifier ]
                      var_decl

# 2.3.6 — Class method  [core FUNC + UFUNCTION macro]

class_method      ::= [ access_specifier ]
                      [ UFUNCTION '(' macro_list ')' ]      (* [pproc] *)
                      [ access_specifier ]
                      function_decl

# 2.3.7 — Virtual property  [core]  (BNF:1 VIRTPROP)
#   Engine parser supports this (ParseVirtualPropertyDecl), but it is a paper
#   feature in the UE fork: ZERO usage in all engine/plugin .as scripts, and
#   the official LSP grammar (pegjs) has no rule for it.  UE's equivalents are
#   UPROPERTY + generated accessors (asTRAIT_GENERATED_FUNCTION) and the
#   property trait on bound Get*/Set* methods (see §4.4 notes).  Tree-sitter
#   should still parse it (cheap, prevents hard errors) but P3 semantics for
#   it are optional/low priority.

virtual_property ::= [ 'private' | 'protected' ] TYPE [ '&' ] IDENTIFIER
                      '{' { ( 'get' | 'set' ) [ 'const' ]
                             [ 'override' | 'final' ]
                             ( statement_block | ';' ) } '}'

# ----------------------------------------------------------------------------
# 2.4  Enumeration  [core]  (BNF:1 ENUM) + UMETA  [pproc]
# ----------------------------------------------------------------------------

enum_decl         ::= [ UENUM '(' macro_list ')' ]          (* [pproc] *)
                      'enum' IDENTIFIER '{' [ enum_list ] '}' ';'
enum_list         ::= enum_value { ',' [enum_value] } [ ',' ]
enum_value        ::= IDENTIFIER [ '=' expression ] [ UMETA '(' macro_list ')' ]

# ----------------------------------------------------------------------------
# 2.5  Delegate / Event  [pproc]
# ----------------------------------------------------------------------------
# Layer-A syntax; [PPROC] rewrites into a class with Bind/Execute/IsBound...
# generated members.  Signature ends with ';' (or a body block in [LSP]).

delegate_decl     ::= 'delegate' function_signature ';'
event_decl        ::= 'event'    function_signature ';'

# ----------------------------------------------------------------------------
# 2.6  Mixin / Local functions  [core]  (BNF:1 MIXIN, LOCAL)
# ----------------------------------------------------------------------------

mixin_function    ::= 'mixin' function_decl_body
local_function    ::= 'local' function_decl_body
(* 'mixin' also appears as a post-'(' method attribute, and as a qualifier
   in func_qualifiers — same word, three positions. *)

# ----------------------------------------------------------------------------
# 2.7  Global functions & variables  [core]  (BNF:0/1 FUNC, VAR)
# ----------------------------------------------------------------------------

global_function   ::= [ UFUNCTION '(' macro_list ')' ]      (* [pproc] *)
                      function_decl

global_var        ::= TYPE [ '&' ] IDENTIFIER
                      [ ( '=' ( init_list | expression ) ) | arg_list ]
                      { ',' IDENTIFIER
                        [ ( '=' ( init_list | expression ) ) | arg_list ] }
                      ';'

function_decl     ::= TYPE [ '&' ] IDENTIFIER parameter_list
                      [ 'const' ] { method_attribute }
                      ( ';' | statement_block )
(* body is SuperficiallyParseStatementBlock at parse time; statements are
   re-parsed lazily per-function by the compiler *)

function_signature ::= TYPE [ '&' ] IDENTIFIER parameter_list
                       [ 'const' ] { method_attribute }

# Method/post-qualifier attributes — contextually-keyworded identifiers
# (ParseMethodAttributes / IsFuncDecl):
method_attribute  ::= 'final' | 'override' | 'property' | 'mixin'
                    | 'no_discard' | 'allow_discard' | 'deprecated'
                    | 'defaults' | 'unsafe_during_construction'
                    | '__generated'
                    | IDENTIFIER      (* forward-compat catch-all [LSP] *)

# ----------------------------------------------------------------------------
# 2.8  Literal asset declaration  [pproc]
# ----------------------------------------------------------------------------
#   asset MyAsset of UTexture2D
# Matched by regex:  asset\s+(\w+)\s+of\s+(\w+)  — a single line, no body.

asset_decl        ::= 'asset' IDENTIFIER 'of' IDENTIFIER

# ----------------------------------------------------------------------------
# 2.9  Removed/legacy top-level declarations  [dead]  (documented for
#       completeness — tokens commented out in as_tokendef.h tokenWords[])
# ----------------------------------------------------------------------------

import_decl      ::= 'import' TYPE ['&'] IDENTIFIER parameter_list 'from'
                     StringLiteral ';'                  (* token removed *)
typedef_decl     ::= 'typedef' PRIMTYPE IDENTIFIER ';'  (* token removed *)
interface_decl   ::= 'interface' IDENTIFIER [':' IDENTIFIER {',' IDENTIFIER}]
                     '{' { virtual_property | interface_method } '}'  (* removed *)
funcdef_decl     ::= 'funcdef' TYPE ['&'] IDENTIFIER parameter_list ';'  (* removed *)


# ############################################################################
#  Part 3 — Declarations internals & statements
# ############################################################################

# ----------------------------------------------------------------------------
# 3.1  Types  [core]  (BNF:4 TYPE, TYPEMOD; 5 SCOPE, DATATYPE)
# ----------------------------------------------------------------------------

TYPE              ::= [ 'const' ] SCOPE DATATYPE
                      [ '<' TYPE { ',' TYPE } '>' ]        (* template, if
                          registered template type *)
                      { ( '[' ']' ) | 'unresolved_object' }
(* '@' handle suffix exists in vanilla; token is removed in UE fork.
   'unresolved_object' is an engine-internal marker after a type name. *)

TYPEMOD           ::= [ '&' [ 'in' | 'out' | 'inout' ] ]   (* reference *)
                      [ '+' ]                              (* engine-internal *)
                      [ 'if_handle_then_const' | 'handle_only'
                      | '__auto_constref_type' | '__any_implicit_integer' ]

DATATYPE          ::= IDENTIFIER | PRIMTYPE | '?' | 'auto'
(* '?' only when parsing app interfaces (C++ side); 'auto' only where
   inference is allowed (local vars, range-for iterators) *)

SCOPE             ::= [ '::' ] { IDENTIFIER '::' }
                      [ IDENTIFIER [ '<' TYPE { ',' TYPE } '>' ] '::' ]
(* innermost scope element may itself be a template instance:
   TArray<int>::Foo(...) *)

# Template subtype lists accept '>>'/'>>>' and split them (ParseTemplTypeList)
# — the tokenizer must be able to end a '>' run mid-token.

scoped_name       ::= [ '::' ] IDENTIFIER { '::' IDENTIFIER }

# ----------------------------------------------------------------------------
# 3.2  Parameter list  [core]  (BNF:3 PARAMLIST)
# ----------------------------------------------------------------------------

parameter_list    ::= '(' [ 'void' | parameter { ',' parameter } [ ',' ] ] ')'
parameter         ::= TYPE TYPEMOD IDENTIFIER [ '=' expression ]
(* default-arg expression is only *superficially* parsed at decl time
   (SuperficiallyParseExpression: balanced () {} <> up to ',' or ')') *)

# ----------------------------------------------------------------------------
# 3.3  UE reflection macro argument lists  [pproc]
# ----------------------------------------------------------------------------
#   UCLASS(...), USTRUCT(...), UENUM(...), UFUNCTION(...), UPROPERTY(...),
#   UMETA(...)
# Values are flat identifier-ish tokens (paths with '::', '|' unions, ':'),
# numbers, or nested macro lists.  String-literal names are allowed
# ([LSP] macro_identifier accepts '...' / "...").

macro_list        ::= [ macro_argument { ',' [macro_argument] } [ ',' ] ]
macro_argument    ::= macro_identifier
                      [ '=' ( macro_value | '(' macro_list ')' ) ]
macro_identifier  ::= IDENTIFIER | StringLiteral | "'" <char> "'"
macro_value       ::= [ '!' ] IDENTIFIER { ('::' | '|' | ':') IDENTIFIER }
                    | contextually_reserved_word     (* e.g. 'true','private' *)
                    | ['-'|'+'] NUMBER

# ----------------------------------------------------------------------------
# 3.4  Statements  [core]  (BNF:7)
# ----------------------------------------------------------------------------

statement         ::= if_statement
                    | for_statement
                    | while_statement
                    | do_while_statement
                    | switch_statement
                    | return_statement
                    | break_statement
                    | continue_statement
                    | fallthrough_statement
                    | statement_block
                    | var_decl                        (* 3.5 *)
                    | expression_statement
                    (* statement-level 'else'/'case'/'default' bodies appear
                       as separate statements in [LSP] because it slices
                       text per-statement — see Part 5.3 *)

statement_block   ::= '{' { var_decl | statement } '}'   (* BNF:2 STATBLOCK *)

if_statement      ::= 'if' '(' condition ')' statement
                      [ 'else' statement ]              (* BNF:8 IF *)

while_statement   ::= 'while' '(' condition ')' statement (* BNF:8 *)

do_while_statement ::= 'do' statement 'while' '(' condition ')' ';'
(* token exists & parser path intact; rarely used in UE code, and absent
   from the [LSP] grammar — keep in Tree-sitter anyway. *)

for_statement     ::= classic_for | range_for

classic_for       ::= 'for' '('
                        ( var_decl | expression_statement )   (* init *)
                        expression_statement                    (* cond *)
                        [ assignment { ',' assignment } ]      (* incr *)
                      ')' statement                             (* BNF:8 *)

range_for         ::= 'for' '(' TYPE TYPEMOD IDENTIFIER ':' condition ')'
                      statement
(* foreach:  for (int I : Range) ...   /  for (auto Elem : MyMap) ...
   [PPROC] rewrites for old iterator mode (angelscript.UseNewIterators=0);
   with new iterators (default) it parses natively as snForRange. *)

switch_statement ::= 'switch' '(' condition ')' '{' { case_clause } '}'
case_clause       ::= ( 'case' expression | 'default' ) ':'
                      { statement }
                      [ ( 'break' ';' ) | ( 'fallthrough' ';' ) ]
(* BNF:8/9; case labels in [ENGINE] only accept expressions (literals or
   scoped names); [LSP] also allows parenthesized labels. *)

return_statement ::= 'return' [ condition ] ';'           (* BNF:8 *)
break_statement   ::= 'break' ';'
continue_statement ::= 'continue' ';'
fallthrough_statement ::= 'fallthrough' ';'

expression_statement ::= [ assignment ] ';'                (* BNF:8 EXPRSTAT *)

# ----------------------------------------------------------------------------
# 3.5  Variable declarations  [core]  (BNF:1 VAR)
# ----------------------------------------------------------------------------

var_decl          ::= TYPE [ '&' ] [ '__auto_constref_type' ]
                      IDENTIFIER
                      [ ( '=' ( init_list | condition ) ) | arg_list ]
                      { ',' IDENTIFIER
                        [ ( '=' ( init_list | condition ) ) | arg_list ] }
                      ';'
(*  Type Name = expr;      — inline assignment
    Type Name(args);      — constructor-initialization (arg_list)
    Type Name = { ... };  — init list
    Local refs:  Type& name = ...;   auto Type name = ...;  *)

# ----------------------------------------------------------------------------
# 3.6  Init lists  [core]  (BNF:4 INITLIST)
# ----------------------------------------------------------------------------

init_list         ::= '{' [ ( assignment | init_list )
                          { ',' [ assignment | init_list ] } ] '}'
(* empty slots allowed:  {1, , 3}  *)

# ----------------------------------------------------------------------------
# 3.7  LSP tolerance productions  [lsp]  — NOT language, do NOT put in
#       Tree-sitter's grammar; implement as error-recovery rules instead
# ----------------------------------------------------------------------------

incomplete_var_decl    ::= TYPE                        (* name not typed yet *)
incomplete_access_spec ::= 'access' ':' [ IDENTIFIER ]
parameter_incomplete   ::= TYPE [ IDENTIFIER [ '=' expression ] ]
argument_list_or_typename ::= ( IDENTIFIER | template_typename ) ')'  (*
                           single typename where args expected, mid-typing *)
incomplete_colon       ::= IDENTIFIER '::'             (* trailing '::' *)


# ############################################################################
#  Part 4 — Expressions
# ############################################################################
#
# [ENGINE] parses expressions FLAT:  EXPR ::= EXPRTERM {EXPROP EXPRTERM}
# and asCCompiler applies precedence afterwards.  For Tree-sitter we instead
# use explicit precedence layers (like lua.bnf §2.4), matching AngelScript's
# documented semantic precedence, UE fork adjusted:
#
#   1.  assignment            =  +=  -=  ...        right
#   2.  ternary ?:                                 right
#   3.  ||                                         left
#   4.  &&                                         left
#   5.  ^^  (logic xor)  — REMOVED in UE fork
#   6.  |                                          left
#   7.  ^                                          left
#   8.  &                                          left
#   9.  ==  !=                                     left
#       ('is' / '!is' — REMOVED in UE fork)
#  10.  <  >  <=  >=                               left
#  11.  <<  >>  >>>                                left
#  12.  +  -                                       left
#  13.  *  /  %                                    left
#  14.  **                                         right
#  15.  unary  -  +  !  ++  --  ~                  prefix
#       ('@' handle-prefix — REMOVED in UE fork)
#  16.  postfix  ++  --  .  []  ()                 postfix
#
# ----------------------------------------------------------------------------

# 4.1 — Precedence-climbing layers (Tree-sitter-ready form)

assignment        ::= ternary_expression
                      [ assign_op assignment ]                       (* right *)
assign_op         ::= '=' | '+=' | '-=' | '*=' | '/=' | '%=' | '**='
                    | '|=' | '&=' | '^=' | '<<=' | '>>=' | '>>>='

ternary_expression ::= logic_or [ '?' ternary_expression ':' ternary_expression ]

logic_or          ::= logic_and { '||' logic_and }                   (* 3 *)
logic_and         ::= bit_or { '&&' bit_or }                         (* 4 *)
bit_or            ::= bit_xor { '|' bit_xor }                        (* 6 *)
bit_xor           ::= bit_and { '^' bit_and }                        (* 7 *)
bit_and           ::= equality { '&' equality }                      (* 8 *)
equality          ::= relational { ( '==' | '!=' ) relational }      (* 9 *)
relational        ::= shift { ( '<' | '<=' | '>' | '>=' ) shift }    (* 10 *)
shift             ::= additive { ( '<<' | '>>' | '>>>' ) additive }  (* 11 *)
additive          ::= multiplicative
                      { ( '+' | '-' ) multiplicative }               (* 12 *)
multiplicative    ::= power { ( '*' | '/' | '%' ) power }            (* 13 *)
power             ::= unary [ '**' power ]                           (* 14, right *)
unary             ::= ( '-' | '+' | '!' | '++' | '--' | '~' ) unary  (* 15 *)
                    | postfix_expression
postfix_expression ::= expr_term { postfix_op }                      (* 16 *)
postfix_op        ::= '++' | '--'
                    | '.' ( IDENTIFIER | function_call_name )        (* member *)
                    | '[' arg_list ']'                               (* index *)
                    | '(' arg_list ')'     (* call on function handle *)

# 4.2 — Expression terms  [core]  (BNF:10-11)

expr_term         ::= 'void'                        (* skip-out-arg marker *)
                    | construct_call
                    | function_call
                    | variable_access
                    | cast_expression
                    | literal
                    | init_list                     (* anonymous { ... } *)
                    | TYPE '=' init_list            (* temp obj w/ init list *)
                    | lambda_expression             (* legacy, see 4.6 *)
                    | '(' condition ')'

# 4.3 — Cast  (BNF:12 CAST; UE fork capitalizes it as keyword 'Cast')
#   'cast' (vanilla lower-case) is NOT a keyword here; only 'Cast'.

cast_expression   ::= 'Cast' '<' TYPE '>' '(' assignment ')'

# 4.4 — Calls and access  (BNF:11-12)

function_call     ::= SCOPE IDENTIFIER '(' arg_list ')'
(* member/method call goes through postfix '.', the head is this rule *)

construct_call    ::= TYPE '(' arg_list ')'
(* recognized when the identifier is a known type, or template
   'TArray<int>(...)', or array type 'type[](...)' — a semantic decision
   the parser approximates by lookahead; Tree-sitter should parse as a
   generic 'call' and let a later pass decide (see Part 5 conflicts). *)

variable_access   ::= SCOPE IDENTIFIER
(* 'this' and 'super' are contextual: parse as ordinary identifiers.
   Super::Foo / this.Foo both fall out of scoped_name + postfix '.' *)

arg_list          ::= '(' [ argument { ',' argument } [ ',' ] ] ')'   (* BNF:13 *)
argument          ::= [ IDENTIFIER ':' ] assignment
(* named argument uses ':' (NOT '='); legacy '=' form exists behind
   ep.alterSyntaxNamedArgs — omit from Tree-sitter.  Index brackets reuse
   arg_list:  Arr[Index] and multi-arg index Arr[A, B] are both valid. *)

# 4.5 — Literals  (BNF:12 LITERAL)

literal           ::= NUMBER
                    | StringLiteral
                    | HeredocString
                    | NameLiteral                    (* n"..."  [pproc] *)
                    | FormatString                   (* f"..."  [pproc] *)
                    | 'true' | 'false' | 'nullptr'
(* 'void' in argument position: Function(void) skips an out-parameter *)

# 4.6 — Anonymous function (lambda)  [core]  (BNF:12 LAMBDA)
#   function(a, b) { ... }   — types optional per-param.
#   Rarely used in UE code (delegates are the UE way); keep for completeness.

lambda_expression ::= 'function' '('
                        [ [ TYPE TYPEMOD ] IDENTIFIER
                          { ',' [ TYPE TYPEMOD ] IDENTIFIER } ]
                      ')' statement_block


# ############################################################################
#  Part 5 — Tree-sitter Implementation Notes
# ############################################################################
#
# 5.1  Two-phase reality
# ----------------------
# A Tree-sitter parser replaces the [LSP] Peggy grammar for syntax duties
# (see my_doc/LSP语法解析流水线说明.md).  It must parse Layer A (source)
# and can IGNORE Layer B rewriting entirely — UCLASS/UFUNCTION/UPROPERTY/
# UMETA macros, delegate/event/asset decls, f""/n"" literals become first-
# class syntax nodes with positions, which the LSP then interprets.  The
# [ENGINE] parser is irrelevant to Tree-sitter except as ground truth for
# what's dead (Part 2.9) and what's real.
#
# 5.2  External scanner (scanner.c) candidates
# ---------------------------------------------
#   - HeredocString  '"""' ... '"""'  — trivial, could be regex, but escape-
#     free multi-line matching is cleaner in a scanner.
#   - FormatString  f"..." — needs brace-nesting awareness: '{' opens an
#     interpolation in which strings/braces must balance.  Recommended:
#     external token `format_string` capturing the whole literal; the LSP
#     layer re-parses interpolations with the same grammar (recursive).
#   - Template '>' splitting: '>>' must be splittable —
#       TArray<TArray<int>>  — the tokenizer sees '>>' as shift.
#     Handle in the grammar via conflicts + lexical precedence, or in a
#     scanner.  (asCParser solves it by SetPos(t.pos+1) token splitting.)
#   - preproc_directive: line-anchored ('#' at first non-ws column).
#     Keep opaque like emmy_line; region queries can mark inactive blocks.
#
# 5.3  The "statement-sliced" LSP shape vs Tree-sitter blocks
# -----------------------------------------------------------
# [LSP] parses each statement independently (if header without body, case
# labels as statements, trailing '::' markers...).  Do NOT replicate this.
# Tree-sitter should build a normal nested tree (if_statement with block).
# The [lsp] productions in §3.7 are the recovery grammar for mid-edit code —
# map them onto Tree-sitter error recovery (externals or `err` recovery
# tokens), not named rules.
#
# 5.4  Known GLR conflicts (grammar.js `conflicts:`)
# ---------------------------------------------------
#   1. TYPE vs expression:  `A<B, C>(x)` — construct call vs relational
#      expression vs template scope `TArray<int>::Foo()`.  Needs GLR with
#      [$_type, $_expression] conflict, or precedence surgery.
#   2. var_decl vs expression_statement:  `Foo Bar;` vs `Foo(Bar);`
#      (classic C++ ambiguity; the engine solves it with multi-token
#      IsType/IsVarDecl lookahead — Tree-sitter solves it with conflicts
#      [_var_decl, $_expression_statement]).
#   3. function_decl vs var_decl at class/global scope:  `Type Name(...)` —
#      '(' after identifier; resolved by what follows ')' ('{' or ';').
#   4. scoped_name vs expression:  `A::B` in default args, case labels,
#      superclass lists — same node shape, different contexts.
#   5. range_for vs classic_for:  `for (Type Name : ...)` vs
#      `for (Type Name = ...)` — ':' vs '=' disambiguates, but both start
#      identically; conflict pair [range_for, classic_for].
#   6. named_argument vs ternary/init:  `f(a : b)` — ':' after identifier
#      inside arg_list is named-arg, but 'a ? b : c' starts the same.
#      Scope the named-arg rule inside arg_list with higher precedence.
#
# 5.5  Precedence & associativity mapping (grammar.js `prec`)
# -----------------------------------------------------------
#   | BNF layer (Part 4)         | prec | assoc  |
#   |-----------------------------|------|--------|
#   | assignment                  |  1   | right  |
#   | ternary_expression          |  2   | right  |
#   | logic_or                    |  3   | left   |
#   | logic_and                   |  4   | left   |
#   | bit_or                      |  6   | left   |
#   | bit_xor                     |  7   | left   |
#   | bit_and                     |  8   | left   |
#   | equality                    |  9   | left   |
#   | relational                  | 10   | left   |
#   | shift                       | 11   | left   |
#   | additive                    | 12   | left   |
#   | multiplicative              | 13   | left   |
#   | power ('**')                | 14   | right  |
#   | unary                       | 15   | prefix |
#   | postfix                     | 16   | postfix|
#
#   Recommended unified node: binary_expression(operator, left, right) +
#   unary_expression + update_expression(++/--) + call_expression +
#   member_expression + subscript_expression + cast_expression —
#   mirroring tree-sitter-cpp naming for query familiarity.
#
# 5.6  Node naming conventions (suggested)
# ------------------------------------------
#   | BNF production            | Tree-sitter node                |
#   |---------------------------|---------------------------------|
#   | SCRIPT                    | source_file                     |
#   | namespace_decl            | namespace_declaration           |
#   | class_decl/struct_decl    | class_declaration / struct_declaration |
#   | enum_decl                 | enum_declaration                |
#   | enum_value                | enumerator                      |
#   | delegate_decl/event_decl  | delegate_declaration / event_declaration |
#   | asset_decl                | asset_declaration               |
#   | global_var / var_decl     | variable_declaration            |
#   | class_property            | property_declaration (UPROPERTY wrapper) |
#   | class_method              | method_declaration (UFUNCTION wrapper) |
#   | constructor_decl          | constructor_declaration         |
#   | destructor_decl           | destructor_declaration          |
#   | function_decl (global)    | function_declaration            |
#   | parameter                 | parameter_declaration           |
#   | access_decl               | access_declaration              |
#   | class_default_statement   | default_statement               |
#   | virtual_property          | virtual_property_declaration    |
#   | macro_list/macro_argument | ufunction_specifier etc. (or generic `macro_argument`) |
#   | for range_for             | for_statement / for_in_statement |
#   | do_while_statement        | do_while_statement              |
#   | case_clause               | switch_body/case_clause         |
#   | init_list                 | initializer_list                |
#   | arg_list/argument         | argument_list / named_argument  |
#   | cast_expression           | cast_expression                 |
#   | preproc_directive         | preproc_line (opaque external)  |
#   | doc_comment run           | comment (attach later in LSP)   |
#
# 5.7  extras
# -----------
#   extras: [ /[\s\r\n]+/ , $.comment, $.preproc_directive ]
#   (Preprocessor lines as extras keeps #if regions transparent to the
#    grammar; if region-aware parse results are wanted later, promote to
#    a structured rule with an external scanner.)
#
# 5.8  Verification corpus
# ------------------------
# Smoke-test the parser against:
#   - d:/WorkGit/UnrealEngine Engine/Plugins/Angelscript content .as files
#   - the [LSP] test suite / any fixtures in language-server/
# Edge cases worth locking into corpus tests:
#   TArray<TArray<int>>  (>> split) |  f"{a:{fmt}}" nested format braces
#   n"Name"  |  0b1010 / 0o777 / 0xFF  |  1.5f / 1.5 (float32 vs float64)
#   for (auto Elem : Map)  |  case A::B:  |  access X = private(readonly), *;
#   default { b = true; }  |  Function(NamedArg: 3, void)  |  {1, , 3}
#   Super::Foo() / this.Bar  |  mixin/local functions  |  UCLASS(meta=(...))
#
# ############################################################################
